# Copy to .env for local development. Use host-managed secrets in production.
# This file contains placeholders only; never commit your populated .env file.
APP_ENV=development
APP_DEBUG=false
APP_BASE_PATH=
# Enable only when requests come through a trusted reverse proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edu_share
DB_USERNAME=edu_share_app
DB_PASSWORD=replace-with-a-strong-local-password

SESSION_NAME=edushare_session
SESSION_LIFETIME_SECONDS=1800

# Use an absolute directory outside the public document root in production.
STORAGE_PATH=/absolute/private/path/edu-share-storage
UPLOAD_MAX_FILES=2
UPLOAD_MAX_BYTES=10485760
