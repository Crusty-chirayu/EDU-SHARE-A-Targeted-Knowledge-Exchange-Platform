diff --git a/tests/static_security_test.py b/tests/static_security_test.py
index 31c8165..737e47b 100644
--- a/tests/static_security_test.py
+++ b/tests/static_security_test.py
@@ -197,6 +197,26 @@ class StaticSecurityTests(unittest.TestCase):
             text = source.read_text(encoding="utf-8")
             self.assertTrue(text.startswith("<?php\ndeclare(strict_types=1);"), str(source.relative_to(ROOT)))
 
+    def test_runtime_workflow_is_active_and_fail_closed(self) -> None:
+        workflow_path = ROOT / ".github/workflows/p0-security.yml"
+        self.assertTrue(workflow_path.is_file())
+        workflow = workflow_path.read_text(encoding="utf-8")
+        self.assertIn("permissions:\n  contents: read", workflow)
+        for marker in (
+            "php-version: '8.2'",
+            "image: mariadb:10.11",
+            "php -l",
+            "php tests/integration.php",
+            "bash tests/http_smoke.sh",
+            "scripts/migrate_legacy_uploads.php",
+            "python3 -m unittest discover",
+            "Academic validation summary: 1 material record(s) require review.",
+        ):
+            self.assertIn(marker, workflow)
+        self.assertNotIn("continue-on-error", workflow)
+        self.assertNotRegex(workflow, r"(?m)\|\|\s*true")
+        self.assertFalse((ROOT / "deploy/github-actions-p0-security.yml.example").exists())
+
 
 if __name__ == "__main__":
     unittest.main(verbosity=2)
